# Copy to .env.local (gitignored) for local dev, or set as build-time env vars
# in the hosting dashboard for production. Both are read at build time via
# import.meta.env — see src/analytics.ts.

# PostHog project API token. Analytics stay fully disabled (no-op) if unset.
VITE_POSTHOG_KEY=

# Where posthog-js sends events. Defaults to PostHog's US Cloud host if unset.
#
# Production sets this to the same-origin reverse proxy so ad-blockers don't
# drop events before they leave the browser:
#
#   VITE_POSTHOG_HOST=https://openshaper.com/edge
#
# That path is served by worker/index.ts, which forwards to PostHog — so it only
# works on a deploy that includes the Worker. Leave it unset (or pointed at the
# direct host) for local dev and forks, where there is no Worker in front.
VITE_POSTHOG_HOST=https://us.i.posthog.com
