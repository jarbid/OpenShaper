{
  "name": "@openshaper/web",
  "version": "0.1.0",
  "description": "OpenShaper web app (the product)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite-react-ssg dev",
    "build": "tsc -b && vite-react-ssg build",
    "preview": "vite preview",
    "coverage": "vitest run --coverage --coverage.include=src --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "og": "node tools/generate-og.mjs",
    "icons": "node tools/generate-icons.mjs",
    "e2e:offline": "playwright test -c playwright.offline.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@openshaper/export": "workspace:*",
    "@openshaper/io": "workspace:*",
    "@openshaper/kernel": "workspace:*",
    "@openshaper/render2d": "workspace:*",
    "@openshaper/render3d": "workspace:*",
    "@openshaper/store": "workspace:*",
    "@openshaper/ui": "workspace:*",
    "@openshaper/units": "workspace:*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.70.0",
    "posthog-js": "^1.447.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.186.1",
    "vite-react-ssg": "0.9.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
