{
  "name": "@openshaper/geom",
  "version": "0.1.0",
  "description": "Pure NURBS geometry core: curves, surfaces, trimming, fitting, solver, B-rep, STEP (experiment branch)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "bench": "vitest bench src --run",
    "build": "tsc -p tsconfig.json --noEmit",
    "coverage": "vitest run --coverage --coverage.include=src --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
