{
  "name": "@openshaper/export",
  "version": "0.1.0",
  "description": "STL / DXF / PDF exporters",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@openshaper/kernel": "workspace:*",
    "clipper-lib": "^6.4.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "coverage": "vitest run --passWithNoTests --coverage --coverage.include=src --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
