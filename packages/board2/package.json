{
  "name": "@openshaper/board2",
  "version": "0.1.0",
  "description": "Section-based board model over the NURBS core: outline, rocker and deck curves, normalised sections, features and the surface evaluator (experiment branch)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./classic": "./src/classic/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "sideEffects": false,
  "dependencies": {
    "@openshaper/geom": "workspace:*",
    "@openshaper/kernel": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "coverage": "vitest run --coverage --coverage.include=src --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@openshaper/io": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
