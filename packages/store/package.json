{
  "name": "@openshaper/store",
  "version": "0.1.0",
  "description": "Board document store, command/undo stack, derived-spec selectors",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@openshaper/kernel": "workspace:*",
    "zustand": "^5.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "coverage": "vitest run --passWithNoTests --coverage --coverage.include=src --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "vitest bench src --run"
  },
  "devDependencies": {
    "@openshaper/io": "workspace:^",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
