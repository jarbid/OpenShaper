{
  "name": "openshaper",
  "version": "0.1.0",
  "private": true,
  "description": "OpenShaper — modern surfboard CAD/CAM (rebuild of BoardCAD-LE)",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@openshaper/web",
    "dev:desktop": "turbo run dev --filter=@openshaper/desktop",
    "build": "turbo run build --filter=!@openshaper/desktop",
    "build:desktop": "turbo run build --filter=@openshaper/desktop",
    "test": "turbo run test",
    "coverage": "turbo run coverage",
    "lint": "eslint . && prettier --check .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17",
      "vite": "^8.3.7",
      "form-data@4": "^4.0.6",
      "fflate@0.6": "^0.6.11"
    }
  }
}
