{
  "name": "openshaper",
  "version": "0.1.0",
  "private": true,
  "description": "OpenShaper — modern surfboard CAD/CAM (rebuild of BoardCAD-LE)",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@openshaper/web",
    "dev:desktop": "turbo run dev --filter=@openshaper/desktop",
    "build": "turbo run build --filter=!@openshaper/desktop",
    "build:desktop": "turbo run build --filter=@openshaper/desktop",
    "test": "turbo run test",
    "coverage": "turbo run coverage",
    "lint": "eslint . && prettier --check .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0"
  }
}
